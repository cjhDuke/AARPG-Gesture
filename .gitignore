# Godot 缓存；保留 *.gd.uid、素材的 *.import 和 .gdignore
.godot/
.import/

# 本机导出配置（沿用项目约定）与导出产物
/export_presets.cfg
/export_templates/
/build/
/bin/
/dist/

# Python 字节码、虚拟环境与工具缓存
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
*.egg-info/

# 手势识别运行数据；保留 config.json、源码和测试
/gesture/state.json
/gesture/screenshots/
/gesture/recordings/

# 本机环境变量；允许提交不含凭据的示例
.env
.env.*
!.env.example
!.env.sample
!.env.template

# 编辑器个人配置
.vscode/
.idea/
*.code-workspace

# 日志、临时文件与编辑器备份
*.log
*.tmp
*.temp
*.bak
*.swp
*.swo
*~

# 操作系统生成的文件
.DS_Store
Thumbs.db
Desktop.ini

# 仅供本机参考的旧方案和后续草稿
/docs/ai/account-cloud-design.md
/docs/ai/expansion-plan.md
/docs/ai/gesture-plan.md
/docs/ai/guard-mode-plan.md
/docs/ai/leaderboard-design.md
/docs/ai/survival-mode-plan.md
/docs/_local/

# 阶段验证临时目录与本地服务数据库
/.stage[0-9]*_checks/
/_ui_verify/
/_ui_layout_check/
/server/*.sqlite*
